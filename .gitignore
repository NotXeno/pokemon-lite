# =========================
# BACKEND (Python / Flask)
# =========================
# Mengabaikan virtual environment
venv/
env/
.venv/

# Mengabaikan file cache bawaan Python
__pycache__/
*.py[cod]
*$py.class

# Mengabaikan file environment variables (kalau nanti ada password/key)
.env
*.env

# =========================
# FRONTEND (React / Vite)
# =========================
# Mengabaikan folder library super berat
node_modules/

# Mengabaikan folder hasil build
dist/
dist-ssr/

# Mengabaikan file log error npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =========================
# OS & CODE EDITOR
# =========================
# Mengabaikan settingan VS Code lokal kamu
.vscode/

# Mengabaikan file sistem operasi
.DS_Store
Thumbs.db

Gemini/